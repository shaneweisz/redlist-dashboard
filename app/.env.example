# IUCN Red List API — assessment-detail tab, and the Literature tab's
# "cited by the assessment" source
RED_LIST_API_KEY=your-red-list-api-key

# Species+ (CITES) API — CITES trade tab
SPECIES_PLUS_API_KEY=your-species-plus-api-key

# Encyclopedia of Life TraitBank (Cypher endpoint) — EOL tab trait data.
# Request a token from EOL (contact hammockj@si.edu); the public EOL data used
# elsewhere in the EOL tab (search, pages, images) needs no token.
EOL_TOKEN=your-eol-jwt-token

# Literature tab — optional extra sources for the species literature timeline.
# OpenAlex and Zenodo need no credentials and are always on, as is the
# assessment's own reference list (it reuses RED_LIST_API_KEY above). Each key
# below activates one further source; without it that source reports itself
# "unconfigured" in the tab's footer and the table still renders.
#   Biodiversity Heritage Library — historical scans, protologues, old floras
#   (free key: https://www.biodiversitylibrary.org/getapikey.aspx).
BHL_API_KEY=your-bhl-api-key
#   Google Books — floras, field guides, Red Data Books. A key is required
#   despite the docs: the anonymous quota is now zero. Any Google Cloud API key
#   with the Books API enabled works.
GOOGLE_BOOKS_API_KEY=your-google-books-api-key
#   CORE — open-access repository content: theses, institutional reports and
#   grey literature with no DOI (https://core.ac.uk/services/api). Members of a
#   subscribing institution can be upgraded to a higher rate limit on request.
CORE_API_KEY=your-core-api-key

# IUCN Red List PostgreSQL — used by the data sync pipeline only (fetch-redlist-species).
# Primary: restore the latest ~/Data/RedList/*.bkp into a local Postgres
# (`brew services start postgresql@16` keeps it running across reboots) and
# point at that on the default port. Fallback: SSH-tunnel the remote SIS DB
# to localhost:5433 if you need data newer than your last local restore.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-local-restore-db-name
DB_USER=your-user
DB_PASSWORD=your-password

# CloudFlare R2 — dashboard data sync (app/data/).
# Used by scripts/fetch-data-from-r2.ts (prebuild) and scripts/upload-data-to-r2.ts.
R2_ACCOUNT_ID=id
R2_ACCESS_KEY_ID=id
R2_SECRET_ACCESS_KEY=key
R2_DATA_BUCKET_NAME=dashboard-data
# Range map / AOH raster storage — iucn-range-maps/ and aoh-maps/ prefixes
# (scripts/upload-range-maps.ts, upload-aoh-maps.ts; range-map + aoh API routes)
R2_MAPS_BUCKET_NAME=dashboard-maps

# PostHog analytics (optional, public). Events are reverse-proxied through
# /ingest (see next.config.ts) so the host is fixed there, not via env.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
